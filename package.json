{
  "name": "geo-content-production-system",
  "version": "1.0.0",
  "description": "这是 GEO 新闻内容生产系统的开发规划仓库。",
  "private": true,
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/geo-api-server.mjs",
    "dev:all": "node server/geo-api-server.mjs & vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run build && npm run test:auth && npm run test:project-isolation && npm run test:writing",
    "test:writing": "node --test server/skill-editor.test.mjs server/batch-editor.test.mjs server/article-format.test.mjs server/writing-engine.test.mjs server/writing-integration.test.mjs server/job-journal.test.mjs server/gallery-placement.test.mjs server/model-request.test.mjs",
    "test:auth": "node --test server/auth.test.mjs",
    "test:project-isolation": "node --test server/project-scope.test.mjs server/project-ui.test.mjs server/frontend-production.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guangtouniuge/gongju.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/guangtouniuge/gongju/issues"
  },
  "homepage": "https://github.com/guangtouniuge/gongju#readme",
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.35.0",
    "marked": "^18.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.62.1"
  }
}
